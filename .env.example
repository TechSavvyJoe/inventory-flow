# The synthetic demo server (pnpm dev:demo) needs only an optional port override.
INVENTORY_OPS_PORT=4174

# The Node server is synthetic-demo only; production runs on the Cloudflare Worker.

# Local demo/testing only. Keep disabled in production; production roles must
# come from the authenticated server session.
VITE_ENABLE_ROLE_PREVIEW=false

# Synthetic/local demo display name only. This is not an authenticated
# production identity and must never contain a password or token.
VITE_DEMO_USER_NAME=Demo user

# A future shared-data deployment should inject its authenticated database or
# API connection here through the host secret store. Never commit a real value.
# INVENTORY_OPS_DATA_URL=
# INVENTORY_OPS_DATA_TOKEN=

# Private Cloudflare release publishing. These values belong only in the local
# Windows secret store / Cloudflare Worker secret store, never in a repository,
# browser bundle, test fixture, terminal transcript, or GitHub Actions log.
# The publisher refuses to send a release unless the manifest and both source
# snapshots validate as complete and current.
# INVENTORY_OPS_CLOUD_URL=https://inventory-ops.joegallant.me
# INVENTORY_OPS_RELEASE_PUBLISHER_TOKEN=<32+-random-characters>
# INVENTORY_OPS_RELEASE_ENCRYPTION_KEY_BASE64=<base64-encoded-32-byte-key>
# CF_ACCESS_CLIENT_ID=<Cloudflare-Access-service-token-client-id>
# CF_ACCESS_CLIENT_SECRET=<Cloudflare-Access-service-token-client-secret>
