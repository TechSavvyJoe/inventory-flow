{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inventory-flow-software-admin-staging",
  "main": "src/platform-worker.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"../dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":true},
  "d1_databases": [
    {"binding":"PLATFORM_DB","database_name":"inventory-flow-platform-staging","database_id":"REPLACE_WITH_SEPARATE_CONTROL_PLANE_DB_ID","migrations_dir":"platform-migrations"},
    {"binding":"TENANT_DEMO_DB","database_name":"isolated-tenant-staging","database_id":"REPLACE_WITH_ISOLATED_TENANT_DB_ID"}
  ],
  "vars": {
    "PRIVATE_HOSTNAME":"REPLACE_WITH_OWNER_HOSTNAME",
    "ACCESS_ISSUER":"REPLACE_WITH_VERIFIED_ACCESS_ISSUER",
    "ACCESS_AUDIENCE":"REPLACE_WITH_SEPARATE_OWNER_ACCESS_AUDIENCE",
    "PLATFORM_TENANT_BINDINGS":"{\"REPLACE_WITH_GROUP_ID\":\"TENANT_DEMO_DB\"}",
    "PLATFORM_SCHEDULER_ENABLED":"false",
    "PLATFORM_SCHEDULER_BATCH_SIZE":"8"
  }
}
