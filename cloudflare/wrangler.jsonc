{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inventory-ops-production",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "INVENTORY_DB",
      "database_name": "inventory-ops-production",
      "database_id": "29bfd3dd-ecd9-4c71-9dba-f0c106c690dd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_SNAPSHOTS",
      "bucket_name": "inventory-ops-private-snapshots"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PRIVATE_HOSTNAME": "inventory-ops.joegallant.me",
    "ACCESS_ISSUER": "https://techsavvyjoe.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "b243147ef0a8b935011b43ed34b5451e44c414c3a7bfe231f9a257039a398040",
    "ACCESS_PUBLISHER_AUDIENCE": "2c2b4041106efedbcd458337db0d33deab4a08c0dc19f083f9c856dd78e56206"
  }
}
