{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inventory-ops-production",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "INVENTORY_DB",
      "database_name": "inventory-ops-production",
      "database_id": "29bfd3dd-ecd9-4c71-9dba-f0c106c690dd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_SNAPSHOTS",
      "bucket_name": "inventory-ops-private-snapshots"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PRIVATE_HOSTNAME": "inventory-ops.joegallant.me"
  }
}
