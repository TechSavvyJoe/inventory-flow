# Generated source caches can contain current inventory, CRM-derived evidence,
# comments, alerts, or customer details. Repository-safe examples belong only
# under fixtures/ and must carry the synthetic-data marker.

# Raster captures can silently contain live VINs, customer/hold details, or
# authenticated-source pages. Keep reviewed vector brand assets and code-based
# design guidance; generate PR screenshots from the synthetic fixture instead.
design/*.png
design/*.jpg
design/*.jpeg
design/*.webp
design/*.heic
design/**/*.png
design/**/*.jpg
design/**/*.jpeg
design/**/*.webp
design/**/*.heic

# Report automation artifacts must never be copied into this app repository.
work/
outputs/
exports/

# Generated language/tool caches.
**/__pycache__/
*.py[cod]

# Local IDE and AI-agent state.
.claude/
.agents/
.tmp-test/
.codex/
.idea/
.vscode/

# Lockfiles: pnpm-lock.yaml is the only tracked lockfile; a stray npm/yarn
# lockfile builds a different dependency tree from the one pnpm test/build use.
package-lock.json
yarn.lock
