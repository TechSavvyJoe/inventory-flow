{
  "name": "maxey-inventory-flow",
  "version": "1.2.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:demo": "concurrently -k -n demo,web -c blue,cyan \"node --watch scripts/start-synthetic-demo.mjs\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/package-extension.mjs",
    "start": "node server/index.mjs --serve-dist",
    "start:demo": "node scripts/start-synthetic-demo.mjs --serve-dist",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa:visual": "node scripts/capture-ui.mjs",
    "cloud:validate": "node scripts/validate-cloud-release.mjs && node --check cloudflare/src/worker.mjs && node --check cloudflare/src/repository.mjs && node --check scripts/publish-cloud-release.mjs",
    "cloud:d1:migrate": "node scripts/block-generic-d1-migrate.mjs",
    "cloud:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "cloud:publish-release": "node scripts/publish-cloud-release.mjs",
    "daily:run": "node scripts/run-inventory-flow-daily.mjs",
    "integrations:client": "node scripts/manage-integration-client.mjs",
    "integrations:verify": "node scripts/verify-integration-deployment.mjs",
    "integrations:deploy": "wrangler deploy --config cloudflare/integrations.wrangler.jsonc",
    "integrations:perplexity-mcp": "node scripts/perplexity-inventory-mcp.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:repo-safety": "node scripts/check-repo-safety.mjs",
    "extension:icons": "node scripts/build-extension-icons.mjs",
    "extension:preview": "node scripts/preview-extension.mjs",
    "check": "pnpm check:repo-safety && pnpm check:design-system && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.97.0"
  }
}
